# Trendyol MCP yapılandırması (opsiyonel)

# TRENDYOL_BASE_URL=https://www.trendyol.com
# (Erkek/Kadın giyim kategorileri UI'dan keşfedilir; ayrı URL değişkeni yok)
# TRENDYOL_PROFILE_DIR=~/.trendyol-mcp/chrome-profile
# TRENDYOL_CHANNEL=chrome
# otomatik (varsayılan: arka planda başlar, engel/giriş olursa pencere açılır) | arka-plan | gorunur
# TRENDYOL_MODE=otomatik
# Boşta kalan tarayıcının kendiliğinden kapanma süresi (ms, 0 = kapalı)
# TRENDYOL_IDLE_CLOSE_MS=300000
# TRENDYOL_VIEWPORT_WIDTH=1440
# TRENDYOL_VIEWPORT_HEIGHT=900
# TRENDYOL_CDP_ENDPOINT=
# TRENDYOL_NAV_TIMEOUT_MS=45000
# TRENDYOL_ACTION_TIMEOUT_MS=15000
# TRENDYOL_SNAPSHOT_MAX_ITEMS=250
# TRENDYOL_DATA_DIR=~/.trendyol-mcp/data
# TRENDYOL_ENABLE_CART=true
# TRENDYOL_CACHE_TTL_MS=600000

# MCP host örneği:
# {
#   "mcp": {
#     "trendyol": {
#       "type": "local",
#       "command": ["node", "/ABSOLUTE/PATH/trendyol-mcp/dist/index.js"],
#       "enabled": true
#     }
#   }
# }
